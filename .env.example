NODE_ENV=development
PORT=3000
# Comma-separated list of allowed browser origins (the CMS frontend, and later the public website)
FRONTEND_URL=http://localhost:5173
# Seconds the public website API may be cached by browsers / CDN (0 = off)
PUBLIC_CACHE_SECONDS=60

# Postgres connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/synexc_cms

JWT_SECRET=change-me

# AWS (image upload)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_BASE_FOLDER=uploads
# Defaults to https://<bucket>.s3.<region>.amazonaws.com. The database stores only S3 keys; the API adds this prefix.
MEDIA_BASE_URL=

# Seed (npm run seed). If SEED_SUPER_ADMIN_PASSWORD is empty a random one is generated and printed once.
SEED_SUPER_ADMIN_EMAIL=superadmin@synexc.com
SEED_SUPER_ADMIN_PASSWORD=
