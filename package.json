  "license": "ISC",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx --watch index.ts",
    "build": "prisma generate && node fix-prisma-imports.js && tsc && node fix-prisma-imports.js",
    "start": "node dist/index.js",
    "seed": "tsx src/seeds/index.ts",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate && node fix-prisma-imports.js",
    "prisma:studio": "prisma studio"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
